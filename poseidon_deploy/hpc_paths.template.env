# Copy to hpc_paths.env (git-ignored) and edit for your HPC account.
# Sourced by every script in hpc_submission_scripts/ via _common.sh.

# Conda environment with POSEIDON installed (conda activate target).
POSEIDON_ENV=/path/to/poseidon/conda/env

# Root of the Sunny Day Flooding Project image archive (stage 00).
IMAGE_DRIVE=/path/to/sunny-day/project/archive

# Site to process: a config name in poseidon_deploy/configs/sites
# (carolina_beach, down_east). Data are read from data/$SITE/.
SITE=carolina_beach
